# Synthetic data only. Copy this file to .env for local configuration.
# The standalone loader reads these settings; environment variables take precedence.

# SQLite is the default database. Relative paths will resolve from the repo root.
DATABASE_URL=sqlite:///data/output/loan_portfolio.db

# Optional MySQL 8.0.16+ option (requires a server and an existing empty database).
# SQLite is tested locally; the MySQL integration test requires a separate server.
# DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@localhost:3306/loan_portfolio

LEGACY_DATA_DIR=data/legacy
OUTPUT_DATA_DIR=data/output
SCHEMA_PATH=sql/schema.sql
# The generator still uses explicit command arguments until Phase 7.
RANDOM_SEED=42
CUSTOMER_COUNT=1000
LOG_LEVEL=INFO
